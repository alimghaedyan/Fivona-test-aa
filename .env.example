# Local development only. Generate a private random value for real deployments.
FINOVA_ENV=development
# Set FINOVA_SECRET_KEY to a random value of at least 32 characters.
# Backward-compatible fallback name: DARIK_SECRET_KEY
FINOVA_SECRET_KEY=
# In production set FINOVA_ENV=production (cookies become Secure automatically).
FINOVA_COOKIE_SECURE=false
# Comma-separated exact frontend origins.
FINOVA_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
